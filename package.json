{
  "name": "personal-workbench",
  "version": "1.0.6",
  "productName": "个人工作台",
  "description": "个人工作执行助手",
  "main": "main.js",
  "appId": "com.personal.workbench",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-win.ps1",
    "test": "node tests/run-regressions.cjs"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.personal.workbench",
    "productName": "个人工作台",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Personal_Workbench_Setup_${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "${productName}",
      "uninstallDisplayName": "${productName}",
      "runAfterFinish": false
    },
    "portable": {
      "artifactName": "Personal_Workbench_Portable_${version}.${ext}"
    },
    "extends": "./electron-builder.common.json"
  }
}
