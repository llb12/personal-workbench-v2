{
  "extends": "./electron-builder.common.json",
  "appId": "com.personal.workbench",
  "productName": "个人工作台",
  "asar": true,
  "compression": "normal",
  "electronVersion": "43.4.1",
  "npmRebuild": false,
  "directories": {
    "output": "release/optimized-1.0.6"
  },
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "signExecutable": false
  },
  "portable": {
    "artifactName": "Personal_Workbench_Portable_${version}.exe"
  }
}
